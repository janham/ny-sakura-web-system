# portal2.mobileselection.jp - SSL Configuration

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name portal2.mobileselection.jp;

    # Redirect all HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name portal2.mobileselection.jp;

    # SSL certificate configuration
    ssl_certificate /etc/letsencrypt/live/portal2.mobileselection.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal2.mobileselection.jp/privkey.pem;

    # SSL protocols and ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';

    # SSL session cache
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS (optional, uncomment for production)
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Document root
    root {{ app_base_dir }}/portal2/public;
    index index.php index.html index.htm;

    # Access and error logs
    access_log /var/log/nginx/portal2_access.log;
    error_log /var/log/nginx/portal2_error.log;

    # PHP-FPM configuration (PHP 7.4)
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/var/opt/remi/php74/run/php-fpm/www.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}
