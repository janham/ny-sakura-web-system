#!/bin/bash
# Web → Batch rsync script
# Generated by Ansible

RSYNC_KEY="{{ rsync_ssh_key_path }}"
BATCH_USER="{{ rsync_user }}"
BATCH_HOST="{{ batch_server_host }}"
BATCH_PORT="{{ batch_server_port }}"
SOURCE_DIR="{{ rsync_source_dir }}"
DEST_DIR="{{ rsync_dest_dir }}"
LOG_FILE="{{ rsync_log_file }}"

# rsync execution
rsync -av --delete \
  -e "ssh -i ${RSYNC_KEY} -p ${BATCH_PORT} -o StrictHostKeyChecking=no" \
{% for pattern in rsync_exclude_patterns %}
  --exclude '{{ pattern }}' \
{% endfor %}
  ${SOURCE_DIR} ${BATCH_USER}@${BATCH_HOST}:${DEST_DIR} \
  >> ${LOG_FILE} 2>&1

# Status log
echo "[$(date)] rsync completed with exit code: $?" >> ${LOG_FILE}
