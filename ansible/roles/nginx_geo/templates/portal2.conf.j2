# Managed by Ansible
# VirtualHost for portal2.mobileselection.jp
# PHP 7.4 (Remi)
# Geo Blocking: Japan Only

server {
    listen 80;
    listen [::]:80;
    # BEGIN ANSIBLE MANAGED SSL CONFIG
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate /etc/letsencrypt/live/portal2.mobileselection.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal2.mobileselection.jp/privkey.pem;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    # END ANSIBLE MANAGED SSL CONFIG

    server_name portal2.mobileselection.jp;

    # BEGIN ANSIBLE MANAGED GEO BLOCKING
    # Geographic Access Control - Japan Only
    if ($allowed_country = no) {
        return {{ geo_block_response_code }};
    }
    # END ANSIBLE MANAGED GEO BLOCKING

    # BEGIN ANSIBLE MANAGED ACME CHALLENGE
    # Allow Let's Encrypt ACME challenges
    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/html/.well-known/acme-challenge/;
        allow all;
        default_type "text/plain";
    }
    # END ANSIBLE MANAGED ACME CHALLENGE

    root /var/www/app/portal2/public;
    index index.php index.html index.htm;

    access_log /var/log/nginx/portal2.mobileselection.jp_access.log main;
    error_log /var/log/nginx/portal2.mobileselection.jp_error.log;

    # CORS対応ヘッダー
    location /master/ {
        try_files $uri =404;

        # CORSヘッダー
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;

        # プリフライト対応
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/var/opt/remi/php74/run/php-fpm/www.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }

    # Deny access to backup files
    location ~ ~$ {
        deny all;
    }

    # BEGIN ANSIBLE MANAGED HTTP TO HTTPS REDIRECT
    # Redirect HTTP to HTTPS
    if ($scheme = http) {
        return 301 https://$server_name$request_uri;
    }
    # END ANSIBLE MANAGED HTTP TO HTTPS REDIRECT
}
