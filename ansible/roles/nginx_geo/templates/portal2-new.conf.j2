# Managed by Ansible
# VirtualHost for portal2-new.mobileselection.jp
# PHP 8.1
# Geo Blocking: Japan Only

# HTTP server - ACME challenge and redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name portal2-new.mobileselection.jp;

    # BEGIN ANSIBLE MANAGED ACME CHALLENGE
    # Allow Let's Encrypt ACME challenges
    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/html/.well-known/acme-challenge/;
        allow all;
        default_type "text/plain";
    }
    # END ANSIBLE MANAGED ACME CHALLENGE

    # Redirect HTTP to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate /etc/letsencrypt/live/portal2-new.mobileselection.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal2-new.mobileselection.jp/privkey.pem;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    server_name portal2-new.mobileselection.jp;

    root /var/www/app/portal2-new/public;
    index index.php index.html index.htm;

    access_log /var/log/nginx/portal2-new.mobileselection.jp_access.log main;
    error_log /var/log/nginx/portal2-new.mobileselection.jp_error.log;

    # BEGIN ANSIBLE MANAGED WEBHOOK ENDPOINT
    # Smaregi Webhook endpoint - NO geo blocking (allow all countries)
    # try_files を使わず直接 PHP-FPM に渡す。
    # try_files による内部リダイレクトを行うと /index.php への再マッチが発生し、
    # トップレベルの location ~ \.php$ (geo blocking あり) に落ちてしまうため。
    location ~ ^/api/smaregi/webhooks/ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
    }
    # END ANSIBLE MANAGED WEBHOOK ENDPOINT

    # CORS対応ヘッダー
    location /externals/ {
        # BEGIN ANSIBLE MANAGED GEO BLOCKING
        # Geographic Access Control - Japan Only
        if ($allowed_country = no) {
            return {{ geo_block_response_code }};
        }
        # END ANSIBLE MANAGED GEO BLOCKING

        try_files $uri =404;

        # CORSヘッダー
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;

        # プリフライト対応
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    location / {
        # BEGIN ANSIBLE MANAGED GEO BLOCKING
        # Geographic Access Control - Japan Only
        if ($allowed_country = no) {
            return {{ geo_block_response_code }};
        }
        # END ANSIBLE MANAGED GEO BLOCKING

        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        # BEGIN ANSIBLE MANAGED GEO BLOCKING
        # Geographic Access Control - Japan Only
        if ($allowed_country = no) {
            return {{ geo_block_response_code }};
        }
        # END ANSIBLE MANAGED GEO BLOCKING

        try_files $uri =404;
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }

    # Deny access to backup files
    location ~ ~$ {
        deny all;
    }
}
