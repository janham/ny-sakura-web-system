# Geographic Access Control - Japan Only
# Auto-generated by Ansible nginx_geo role
# Generated: {{ ansible_date_time.iso8601 }}

geo $allowed_country {
    default no;

    # Japan IP ranges (from APNIC)
{% for ip in japan_ipv4_list.stdout_lines %}
    {{ ip }} yes;
{% endfor %}

    # Private IP ranges (internal access)
    10.0.0.0/8 yes;
    172.16.0.0/12 yes;
    192.168.0.0/16 yes;

    # Localhost
    127.0.0.0/8 yes;
    ::1/128 yes;
}
